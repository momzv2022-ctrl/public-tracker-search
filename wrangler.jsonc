{
  // What a one-click deploy reads, and what `wrangler deploy` uses. None of it
  // is needed to paste the file by hand — that path has no configuration at
  // all — but a deploy from this repository has to be told which file is the
  // program.
  //
  // There is nothing to provision: no KV, no D1, no R2, no queue, no build
  // step. One file, no dependencies. The only thing a fresh deployment needs
  // that is not in the repository is a key, and a key is a secret — asked for
  // at deploy time, declared in `.dev.vars.example`.
  "name": "public-tracker-search",
  "main": "worker/src/worker.js",
  "compatibility_date": "2025-01-01",

  // The whole setup depends on getting a `workers.dev` address back: it is the
  // URL the Worker prints on its own front page, and the one the app uses.
  "workers_dev": true
}
