          "search_type": "100%",
          "search_field": "title",
          "query": "{q}",
          "order_by": "seeders",
          "order_direction": "desc",
          "from": 0,
          "size": "{limit}",
          "hide_unsafe": true
        }
      },
      "rows": "hits",
      "rows_required": true,
      "provenance": "tracker",
      "fields": {
